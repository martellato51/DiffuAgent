#!/bin/bash
#SBATCH --job-name=tpv2_smoke_exp
#SBATCH --partition=jobs
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:2
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --output=think_parallel_v2/logs/tpv2_smoke_exp.%j.log
#SBATCH --error=think_parallel_v2/logs/tpv2_smoke_exp.%j.log

set -euo pipefail

ROOT="${ROOT:-/home/ilju/research/DiffuAgent/think_parallel_v2}"
mkdir -p "$ROOT/logs"

CONDITION=explicit "$ROOT/scripts/run_smoke_condition.sh"
